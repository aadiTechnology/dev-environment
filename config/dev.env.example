# Safe development placeholders. Copy to gitignored config/dev.local.env.
# Do not put passwords, tokens, or connection strings in this file.

CONTROL_PLANE_API_BASE_URL=http://localhost:8000
CRM_API_BASE_URL=http://localhost:8001
CONTROL_PLANE_WEB_URL=http://localhost:5173
CRM_WEB_URL=http://localhost:5174

# These names must match the development databases the bootstrap may create.
# aadi_platform is the Control Plane DATABASE_URL database.
# aadi_crm_dev is the CRM database. The existing aadi_crm database is not dropped.
CONTROL_PLANE_DATABASE_NAME=aadi_platform
CRM_DATABASE_NAME=aadi_crm_dev

TENANT_NAME=Aadi CRM Development
PRODUCT_KEY=crm
PRODUCT_NAME=CRM
PLAN_KEY=crm-development
PLAN_NAME=CRM Development
ROLE_KEY=crm_development
ROLE_NAME=CRM Development
CRM_ADMIN_EMAIL=crm.admin@example.test

# Set IDENTITY_PASSWORD in the shell for this session, or in gitignored
# config/dev.local.env. Do not commit a password and do not paste one into chat.
# IDENTITY_PASSWORD=
